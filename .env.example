# Copy this file to .env and fill in your values. .env is ignored by git — never commit it.
#
# ── Online database (filess.io or any hosted PostgreSQL) ───────────────────────────────
# Option A: the separate fields from the provider dashboard (easiest: no URL-encoding needed
# if your password contains characters like @ : / ?). Put the password in double quotes:
# in .env files an unquoted # starts a comment and would cut the password short.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=""

# Option B: a single connection string instead of the fields above (leave DB_HOST empty).
# Special characters in the password must be URL-encoded (e.g. @ → %40).
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME

# Schema for the app's tables. Needed on hosts like filess.io where your user has no default
# schema ("no schema has been selected to create in"). The app creates it if it's missing.
# Lowercase letters, digits and underscores only.
DB_SCHEMA=predictpool

# SSL: require (verify the certificate), no-verify (encrypt, but accept a self-signed
# certificate), or off. Use require or no-verify where the server supports it.
# filess.io's free shared plan does not accept SSL on its standard port: use off there.
DB_SSL=require
# DB_SSL_CA=./certs/provider-ca.pem

# Free shared plans allow very few connections (about 3 on filess.io's free tier).
# Keep this at least one below the limit so a SQL editor can still connect.
DB_POOL_MAX=2

# The background worker polls the database; poll less often to save connections and queries.
WORKER_POLL_MS=2000

# ── Local tests always use a local database (they erase it on every run) ──────────────
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/predictpool_test
